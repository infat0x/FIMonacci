SECRET_KEY=change-me
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Monitoring paths (colon-separated). Leave empty to use default monitored folder.
FIMONACCI_PATHS=
# Set to 1 to disable server-side monitoring threads.
DISABLE_MONITORING=0
# Set on platforms like Vercel to skip background threads.
VERCEL=0

# Alerting toggles
AUTO_ALERTS_ENABLED=true
EMAIL_ALERTS_ENABLED=false
SLACK_ALERTS_ENABLED=false
TELEGRAM_ALERTS_ENABLED=false

# AI analysis
AI_ANALYSIS_ENABLED=false
# AI_PROVIDER can be: mistral | grok
AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROK_API_KEY=
GROK_API_URL=

# Wazuh integration
WAZUH_ENABLED=false
WAZUH_MANAGER_URL=http://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# Telegram bot
TELEGRAM_BOT_TOKEN=

